<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
   xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CAC9C9">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#D22323">
        <ImageButton
            android:id="@+id/imgBackAD"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_back"
            android:rotation="180"
            android:scaleType="centerInside"
            android:background="#D22323" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quản lý"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="25sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="30dp"
            android:orientation="vertical">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardQuanLyPhim"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                app:cardCornerRadius="17dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFCFC">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_film"
                        android:layout_marginStart="18dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Quản lý phim"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_marginStart="20sp"
                        android:textColor="@color/black"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:maxLines="1"/>
                    <ImageView
                        android:id="@+id/imgQlyPhim"
                        android:layout_width="60dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_next"
                        android:layout_marginStart="50dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardQuanLyLichChieu"
                android:layout_marginTop="30dp"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                app:cardCornerRadius="17dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFCFC">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_lichphim"
                        android:layout_marginStart="18dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quản lý lịch chiếu"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_marginStart="20sp"
                        android:textColor="@color/black"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:maxLines="1"/>
                    <ImageView
                        android:id="@+id/imgQlyLichChieu"
                        android:layout_width="60dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_next"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardQuanLyTaiKhoan"
                android:layout_marginTop="30dp"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                app:cardCornerRadius="17dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFCFC">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_profileden"
                        android:layout_marginStart="18dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quản lý tài khoản"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_marginStart="20sp"
                        android:textColor="@color/black"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:maxLines="1"/>
                    <ImageView
                        android:id="@+id/imgQlyTaiKhoan"
                        android:layout_width="60dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_next"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>