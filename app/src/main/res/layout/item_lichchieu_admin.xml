<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="2dp"
        app:strokeColor="#CCCCCC"
        app:cardElevation="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imgPosster"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:src="@drawable/dia_dao_poster"
                android:layout_marginStart="10dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp">
                <TextView
                    android:id="@+id/txtTenMovie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Địa đạo"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/black"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtNgaykhoiChieu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07/09/2020"
                        android:textSize="16sp"
                        android:textColor="@color/black"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" - "
                        android:textSize="16sp"
                        android:textColor="@color/black"/>
                    <TextView
                        android:id="@+id/txtGioChieu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23:10"
                        android:textSize="16sp"
                        android:textColor="@color/black"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phòng: "
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>
                    <TextView
                        android:id="@+id/txtPhong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P2"
                        android:textSize="16sp"
                        android:textColor="@color/black"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá vé: "
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/txtGiaVe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45.000đ"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnXem"
                        android:layout_width="50dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:text="Xem"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:layout_gravity="center_vertical"
                        android:padding="1dp"
                        app:rippleColor="#33FFFFFF"
                        app:strokeColor="#C3BABA"
                        app:strokeWidth="1dp"
                        app:cornerRadius="5dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="15dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSua"
                        android:layout_width="50dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:text="Sửa"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:layout_gravity="center_vertical"
                        android:padding="1dp"
                        app:rippleColor="#33FFFFFF"
                        app:strokeColor="#C3BABA"
                        app:strokeWidth="1dp"
                        app:cornerRadius="5dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnXoa"
                        android:layout_width="50dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:text="Xóa"
                        android:textColor="#FF0000"
                        android:textSize="15sp"
                        android:layout_gravity="center_vertical"
                        android:padding="1dp"
                        app:rippleColor="#33FFFFFF"
                        app:strokeColor="#FF0000"
                        app:strokeWidth="1dp"
                        app:cornerRadius="5dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="15dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>