<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#D22323">
        <ImageButton
            android:id="@+id/imgpach"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_back"
            android:rotation="180"
            android:scaleType="centerInside"
            android:background="#D22323" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng ký"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="25sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">
                    <TextView
                        android:layout_marginTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THÔNG TIN BẮT BUỘC"
                        android:layout_gravity="center_horizontal"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="10dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Họ và tên"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeMaxTextSize="19sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:autoSizeStepGranularity="1sp"
                            android:textSize="17sp"/>
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_sao"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/edtHoVaTen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_title_border"
                        android:hint="Nhập họ và tên"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:inputType="text"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="15dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Địa chỉ Email"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeMaxTextSize="19sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:autoSizeStepGranularity="1sp"
                            android:textSize="17sp"/>
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_sao"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_title_border"
                        android:hint="Nhập địa chỉ email"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:inputType="textEmailAddress"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="15dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mật khẩu"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeMaxTextSize="19sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:autoSizeStepGranularity="1sp"
                            android:textSize="17sp"/>
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_sao"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_title_border">
                        <EditText
                            android:id="@+id/edtPassWord"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="Nhập mật khẩu"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:background="@android:color/transparent"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:inputType="textPassword"
                            android:scrollHorizontally="true"
                            android:autoSizeMinTextSize="15sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeTextType="uniform"
                            android:autoSizeStepGranularity="1sp"/>
                        <ImageView
                            android:id="@+id/imgHienMK"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_anmk"
                            android:layout_gravity="center"
                            android:layout_marginLeft="2dp"/>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="15dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhập lại mật khẩu"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeMaxTextSize="19sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:autoSizeStepGranularity="1sp"
                            android:textSize="17sp"/>
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_sao"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_title_border">
                        <EditText
                            android:id="@+id/edtNhapLaiPassWord"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="Nhập lại mật khẩu"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:background="@android:color/transparent"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:inputType="textPassword"
                            android:scrollHorizontally="true"
                            android:autoSizeMinTextSize="15sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeTextType="uniform"
                            android:autoSizeStepGranularity="1sp"/>
                        <ImageView
                            android:id="@+id/imgHienMK2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_anmk"
                            android:layout_gravity="center"
                            android:layout_marginLeft="2dp"/>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="15dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số điện thoai"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeMaxTextSize="19sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:autoSizeStepGranularity="1sp"
                            android:textSize="17sp"/>
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_sao"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/edtSDT"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_title_border"
                        android:hint="Nhập số điện thoại"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:maxLines="1"
                        android:inputType="number"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"/>
                    <TextView
                        android:layout_marginTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THÔNG TIN BỔ SUNG"
                        android:layout_gravity="center_horizontal"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CMND/CCCD"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeMaxTextSize="19sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:autoSizeStepGranularity="1sp"
                        android:textSize="17sp"
                        android:layout_marginTop="15dp"/>
                    <EditText
                        android:id="@+id/edtCCCD"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_title_border"
                        android:hint="Nhập căn cước công dân"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:inputType="number"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngày sinh"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeMaxTextSize="19sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:autoSizeStepGranularity="1sp"
                        android:textSize="17sp"
                        android:layout_marginTop="15dp"/>
                    <EditText
                        android:id="@+id/edtNgaySinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_title_border"
                        android:hint="Chọn ngày sinh"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="none"
                        android:drawableEnd="@drawable/ic_lich"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giới tính"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeMaxTextSize="19sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:autoSizeStepGranularity="1sp"
                        android:textSize="17sp"
                        android:layout_marginTop="15dp"/>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Spinner
                            android:id="@+id/spnGioiTinh"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/bg_title_border"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_next"
                            android:rotation="90"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginTop="3dp"
                            android:clickable="false"
                            android:focusable="false"
                            />
                    </FrameLayout>
                    <CheckBox
                        android:id="@+id/ckCamKet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chúng tôi cam kết tuân theo chính sách bảo mật và điều khoản sử dụng của CineGo"
                        android:textSize="13sp"
                        android:layout_marginTop="5dp"
                        android:textColor="#BF2828"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="20dp">
                        <Button
                            android:id="@+id/btnDangKy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đăng ký"
                            android:layout_gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:background="@android:color/transparent"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

